{
  "name": "nero-royal-library",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "wrangler dev --test-scheduled",
    "check": "npm run typecheck && npm test && npm run build && wrangler deploy --dry-run",
    "db:local": "wrangler d1 migrations apply nero-library --local",
    "db:remote": "wrangler d1 migrations apply nero-library --remote"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "latest",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "latest"
  }
}
